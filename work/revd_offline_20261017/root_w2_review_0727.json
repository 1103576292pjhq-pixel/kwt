  "lifecycle_conclusions": [
    {
      "id": "W2-SLOT-001",
      "status": "SOURCE_SUPPORTED_WITH_CURRENT_DIRECTED_EVIDENCE",
      "observation": "New8 SP banks separate active read slot and loading write slot; slot-state guard requires LOADING for W/b writes, ACTIVE for read ownership. Active slot is unchanged through read return/MAC/quant/Y drain, so selecting returned bank by active_slot is safe under this lifecycle; tag_slot/product_slot are passively asserted against active slot.",
      "new_vs_W1": "W1 defers OPEN until the single owner releases; W2 can load a FREE second slot while current slot is ACTIVE."
    },
    {
      "id": "W2-START-002",
      "status": "SOURCE_SUPPORTED",
      "observation": "Before START only tile0 OPEN is legal even with free second slot; future OPEN retires illegal rather than waiting in front of START. After START an otherwise legal future OPEN may be accepted into the ordered q then deferred when both slots owned; this inhibits only retirement of that command, not existing compute/Y drain. Input payload stays stable under backpressure."
    },
    {
      "id": "W2-RETURN-003",
      "status": "SOURCE_SUPPORTED",
      "observation": "WAIT_TILE switches active_slot only after the prior tile final public Y handshake; all reads and final MAC were drained in FLUSH and all bias epilogues completed before DRAIN. Reset clears both slot states and tag/product valids. Bias writes use load_slot, epilogue reads active_slot; no owner release while bias/read response remains referenced."
    },
    {
      "id": "W2-SAME-EDGE-004",
      "status": "CURRENT_EVIDENCE_PRESENT",
      "observation": "COMMIT of loading slot and old tile finalY affect distinct slot-state elements. WAIT_TILE consumes new READY on following cycle. New commit_last_Y L1/L2 cases now explicitly hit COMMIT_LAST_Y task27 tile1 oldtile0 index143 and report hitcount1; both actual compile/sim exit0 and source hashes match. This closes the old round1 missing-dynamic-coverage observation at source/test-evidence level."
    },
    {
      "id": "W2-RESET-005",
      "status": "CURRENT_EVIDENCE_PRESENT",
      "observation": "phase6 has active+ready slots plus deferred thirdOPEN, then reset and new task; currentL1/L2 receipts compile/sim0 and fresh source match. reset_wait_tile, partial X/W, RAM-return, MAC, epilogue and output phases are in the expanded protocol inventory. Published block held under fault, fault blocks new successful work untilreset; ownership is poisoned rather than reused."
    },
    {
      "id": "W2-Y-DONE-006",
      "status": "SOURCE_SUPPORTED_WITH_CURRENT_BOUNDARY_EVIDENCE",
      "observation": "Y remains single buffer; DRAIN advances only actual out_ready fire and retains stalled payload. Final global out_last closes ingress for entire final hold and done pulse; prior accepted invalid event overrides success and preserves already published block. core_done only after finalY and equality of ingress accepted/retired checked by TB. Pending-last-fire/blocked and nextBEGIN protocol receipts checked fresh."
    },
    {
      "id": "W2-OVERLAP-007",
      "status": "MEASURED_SEPARATE_COUNTERS_PRESENT",
      "observation": "Current productionL1/L2 have15360 W writes during processing, max_owned2 and9360 direct cross-SP read/write, read-issue/write and MAC-retire/write cycles. These direct metrics now support real overlap instead of treating all processing-phase writes as MAC overlap. Per-bank rd&wr is separately forbidden by TB."
    }
  ],
