      "id": "W2-R1-01",
      "severity": "HIGH",
      "status": "OPEN",
      "area": "acceptance_closure",
      "finding": "W2仍须专属独立gate，完整99生产L1/L2、full36、repeat、all48及相应新鲜身份/负测证据。不得借W1/D3 gate或作者PASS签W2。",
      "gate_files_observed": [
        "scripts\\revd_offline_tiled_w2_gate.py"
      ],
      "required_fix": "固定W2七源/8bank/W2_STATS/slot tags；42精确测试与10实际mutation，phase6特殊13×48满slot/第三OPEN输入单独pin；严格非负RAW；full36精确身份；缺项/别名/假argv/nonzero/错flags/index/删末项负测。"
    },
    {
      "id": "W2-R1-02",
      "severity": "MEDIUM",
      "status": "NOT_EXPLICITLY_EVIDENCED",
      "area": "same_edge_lifecycle",
      "finding": "源码同拍COMMIT/old-tile末Y写不同slot状态，WAIT_TILE读取READY在后一拍，未见确定竞争缺陷。但42项未有明确同拍定向case或命中计数，不能说此边界已动态验证。",
      "required_fix": "增加能证明COMMIT退休与旧tile最后Y握手同拍的明确命中/结果检查；若本批不做，明确此定向覆盖待验，保留已接受W1/D3。",
      "marker_found": false
    },
    {
      "id": "W2-R1-03",
      "severity": "MEDIUM",
      "status": "METRIC_BOUNDARY",
      "area": "overlap_measurement",
      "finding": "overlap_writes=w_write&&processing，processing包括QWAIT/DRAIN；可证明活跃任务阶段加载，不能直接标成同拍MAC/read与write重叠次数。",
      "required_fix": "分别报告其真实含义；若声称RAM读写同拍重叠，记录(|w_rd)&&(|w_wr)等直接RTL事件，且保持每bank !(rd&&wr)。"
    },
    {
      "id": "W2-R1-04",
      "severity": "MEDIUM",
      "status": "INHERITED_CHECKER_BLIND_SPOT",
      "area": "RAW_identity",
      "finding": "tiled_w2_runner.py RAW身份仍无负下界，继承W1 NumPy负索引误收风险。当前本审查对实际证据采用0<=index<M*N已通过。",
      "required_fix": "W2独立gate严格非负task/index/unique/count/value；不能仅借runner raw48_checked字段。"
    }
