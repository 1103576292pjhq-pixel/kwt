  "closure_reasoning": [
    {
      "file": "rtl/revd/core_stream_frontend.sv",
      "line": 42,
      "point": "The whole final published record closes in_ready, including out_ready=0. Therefore no new input can enter q_* on the final output handshake, removing the original same-edge hole."
    },
    {
      "file": "rtl/revd/core_stream_frontend.sv",
      "line": 149,
      "point": "An event accepted before the final record still retires normally. Every such event is illegal in DRAIN; retire_event&&!command_ok suppresses the normal completion transition and sets sticky fault. The published final payload remains held/drained by the existing fault path."
    },
    {
      "file": "rtl/revd/core_stream_frontend.sv",
      "line": 42,
      "point": "in_ready is also low while core_done is visible. A legal BEGIN held stable at the final record cannot handshake until both the old output and done pulse have cleared. It then enters IDLE ownership, retires BEGIN, and the following X load remains ordered."
    },
    {
      "file": "dv/revd/core_tb.sv",
      "line": 140,
      "point": "The new passive done assertion rejects q_valid or input_accepts!=event_retires. Directed scenarios explicitly distinguish offered-but-unaccepted terminal input from truly accepted earlier illegal events, and verify held next-BEGIN resumption."
    }
  ],
